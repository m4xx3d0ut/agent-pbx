# Agent PBX local launch configuration.
# Copy to local.env, edit for your machine, then run: source ./local.env

export AGENT_PBX_HOST="127.0.0.1"
export AGENT_PBX_PORT="8765"
export AGENT_PBX_TOKEN="change-me"
export AGENT_PBX_SERVER_URL="http://${AGENT_PBX_HOST}:${AGENT_PBX_PORT}"
export AGENT_PBX_MCP_URL="${AGENT_PBX_SERVER_URL}/mcp"

# Set to 1 for verbose daemon logs during local development.
export AGENT_PBX_DEBUG="0"

# Optional: enable the TUI WorkerBee tab. Must point at a WorkerBee executable.
# export AGENT_PBX_WORKERBEE_BIN="/path/to/k1s-workerbee/.venv/bin/workerbee"
# Increase if WorkerBee has many project records or slow local storage.
export AGENT_PBX_WORKERBEE_TIMEOUT_SECONDS="20"
export AGENT_PBX_WORKERBEE_CACHE_SECONDS="10"

# Optional: enable the TUI Joplin tab and MCP document export tools. Start a
# Joplin desktop/terminal REST API profile first, then set its API URL/token.
# Keep WebDAV credentials in gitignored local.env only.
# export AGENT_PBX_JOPLIN_API_URL="http://127.0.0.1:41184"
# export AGENT_PBX_JOPLIN_TOKEN="change-me"
export AGENT_PBX_JOPLIN_NOTEBOOK="Agent PBX"
# export AGENT_PBX_JOPLIN_BIN="/path/to/joplin"
# export AGENT_PBX_JOPLIN_PROFILE="$HOME/.config/joplin-agent-pbx"
export AGENT_PBX_JOPLIN_TIMEOUT_SECONDS="15"
export AGENT_PBX_JOPLIN_SYNC_ON_WRITE="0"
# export AGENT_PBX_JOPLIN_WEBDAV_URL="https://webdav.example.local/joplin"
# export AGENT_PBX_JOPLIN_WEBDAV_USERNAME="agent-pbx"
# export AGENT_PBX_JOPLIN_WEBDAV_PASSWORD="change-me"

# TUI preferences. Use "compact" for narrow/mobile terminals.
# agent-pbx-tui reads ${XDG_CONFIG_HOME:-~/.config}/agent-pbx/tui.env by
# default; set AGENT_PBX_TUI_CONFIG to use another per-user config file.
# export AGENT_PBX_TUI_CONFIG="$HOME/.config/agent-pbx/tui.env"
export AGENT_PBX_TUI_LAYOUT="split"
export AGENT_PBX_TUI_THEME="cyberpunk"  # cyberpunk, minimal, or 1337
export AGENT_PBX_TUI_AGENT_BLINK="1"
# Use this for very slow remote terminals such as PocketCHIP watch screens.
# It keeps event-stream alerts active but reduces periodic redraw work.
export AGENT_PBX_TUI_LOW_POWER="0"
export AGENT_PBX_TUI_AGENT_REFRESH_SECONDS="2"
export AGENT_PBX_TUI_ATTENTION_BLINK_SECONDS="0.8"

# Experimental local-only tmux direct mode. When enabled, the TUI can replace
# the selected agent Latest tab with a captured local tmux pane and paste input
# directly into that pane. Capture lines 0 means visible pane only; positive
# values include scrollback and may show older session output. Increase the
# refresh interval if redraws are distracting on a slow or narrow terminal.
export AGENT_PBX_TUI_TMUX="0"
export AGENT_PBX_TUI_TMUX_CAPTURE_LINES="0"
export AGENT_PBX_TUI_TMUX_REFRESH_SECONDS="1.5"
